{
  "manifest_version": 3,
  "name": "保存到 Index（Demo）",
  "version": "0.1.0",
  "description": "在 Microsoft Edge 中右键图片，保存到本机 Index 图库。",
  "icons": {
    "16": "icons/index-16.png",
    "32": "icons/index-32.png",
    "48": "icons/index-48.png",
    "128": "icons/index-128.png"
  },
  "permissions": [
    "contextMenus",
    "nativeMessaging",
    "scripting"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "保存到 Index（Demo）",
    "default_icon": {
      "16": "icons/index-16.png",
      "32": "icons/index-32.png"
    }
  },
  "key": ""
}
