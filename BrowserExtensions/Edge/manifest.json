{
  "manifest_version": 3,
  "name": "保存到 MacShot（Demo）",
  "version": "0.1.0",
  "description": "在 Microsoft Edge 中右键图片，保存到本机 MacShot 图库。",
  "permissions": [
    "contextMenus",
    "nativeMessaging",
    "scripting"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "保存到 MacShot（Demo）"
  },
  "key": ""
}
