<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>MacShot</string>
    <key>CFBundleDisplayName</key>
    <string>MacShot</string>
    <key>CFBundleIdentifier</key>
    <string>com.wxyhgk.macshot</string>
    <key>CFBundleExecutable</key>
    <string>MacShot</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSMinimumSystemVersion</key>
    <string>14.0</string>
    <!-- 菜单栏常驻，不占 Dock -->
    <key>LSUIElement</key>
    <true/>
    <key>NSHighResolutionCapable</key>
    <true/>
    <!-- 取浏览器当前标签页地址需要 Apple Events 授权 -->
    <key>NSAppleEventsUsageDescription</key>
    <string>MacShot 需要询问浏览器当前页面的网址，以便把它记录到截图的元数据里。</string>
    <!-- 录屏可选录麦克风（设置里默认关，首次开启触发此弹窗） -->
    <key>NSMicrophoneUsageDescription</key>
    <string>MacShot 需要使用麦克风，以便在录屏时把你的声音一起录进视频。</string>
    <!-- URL scheme：快捷指令 / Raycast / 终端 open 都能经 macshot:// 调起，见 App/URLCommandRouter.swift -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>com.wxyhgk.macshot</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>macshot</string>
            </array>
        </dict>
    </array>
    <!-- 服务菜单：无输入类型 → 出现在所有 App 的「服务」菜单里。
         注意：服务注册按签名+路径缓存，改动后可能要 pbs -update 或重新登录才生效。 -->
    <key>NSServices</key>
    <array>
        <dict>
            <key>NSMenuItem</key>
            <dict>
                <key>default</key>
                <string>用 MacShot 截图</string>
            </dict>
            <key>NSMessage</key>
            <string>captureService</string>
            <key>NSPortName</key>
            <string>MacShot</string>
        </dict>
    </array>
</dict>
</plist>
